# 이 파일을 복사해서 .env.local 을 만들고 실제 값을 채우세요.
#   cp .env.local.example .env.local
# .env.local 은 .gitignore 에 의해 커밋되지 않습니다.

# MongoDB Atlas 접속 문자열 (Connect → Drivers)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/portfolio?retryWrites=true&w=majority

# 세션 쿠키 서명 키 — `npx auth secret` 으로 발급
AUTH_SECRET=

# 관리자(포트폴리오 주인) 이메일 — 이 이메일로 가입한 계정만 /admin 접근 가능
ADMIN_EMAIL=you@example.com
